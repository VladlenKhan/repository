# ===== Telegram =====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg
# Произвольная случайная строка (A-Z, a-z, 0-9, _ и -), 1-256 символов.
# Telegram будет присылать её в заголовке X-Telegram-Bot-Api-Secret-Token,
# а бот — отвергать запросы без неё. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=смените_на_случайную_строку

# ===== Рыночные данные =====
# Ключ Twelve Data: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
# ===== Макроданные =====
# Ключ FRED: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Telegram ID владельца. Войдя через Telegram, он получает роль owner.
# Узнать свой ID можно у @userinfobot
OWNER_TELEGRAM_ID=

# Секрет подписи сессий. Сгенерировать: openssl rand -hex 32
# Его смена разом завершает все сессии.
SESSION_SECRET=

# ===== Языковая модель (необязательно) =====
# Свой ключ Gemini: https://aistudio.google.com/apikey
# Бесплатный тариф, кредиты Netlify не тратит. Без ключа бот и панель
# работают полностью — не будет только команды /ai и раздела с разбором.
#
# Имя именно GOOGLE_AI_KEY, а не GEMINI_API_KEY: последнюю Netlify
# подставляет в функции сам, для своего AI Gateway, и это другой токен.
GOOGLE_AI_KEY=
# Модель по умолчанию: gemini-2.5-flash
GEMINI_MODEL=

# ===== Прочее =====
# Язык по умолчанию для новых пользователей: ru или en
DEFAULT_LANG=ru
# Публичный адрес сайта, нужен только скрипту set-webhook
URL=https://your-site.netlify.app
